root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx,toml}]
indent_size = 2

[*.{rs,py,ps1,psm1,psd1,cs}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

# C# declaration wrapping is documented in docs/development/csharp-conventions.md.
# The SDK whitespace formatter preserves it; review enforces parameter-per-line layout.
[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion
