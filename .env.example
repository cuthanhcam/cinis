# Reference only: scripts do not automatically load dotenv files.
# Export variables in the calling shell or use the host's approved secret mechanism.
# Optional GitHub API authentication for private repositories or higher rate limits.
GH_TOKEN=
# Optional Rust panic diagnostics; use 0 or 1.
RUST_BACKTRACE=1
# Optional direct .NET host overrides (not loaded automatically; Serve fixes loopback explicitly).
# ASPNETCORE_ENVIRONMENT=Development
# ASPNETCORE_URLS=http://localhost:5080
